{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "shell": "bash",
            "command": "npm run type-check || exit 2",
            "statusMessage": "Type-check gate before commit…",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
