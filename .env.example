# Environment Variables
#
# Copy this file to `.env.local` (git-ignored) and adjust for your machine.
# Only NEXT_PUBLIC_* vars are read by the browser bundle.

# API Configuration
# Local backend default. The FE falls back to this same value in code if unset.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (login "Continue with Google" tab) — BLOCKED on PJP-72 / S1-04.
# Client ID not yet issued; the Google tab is rendered DISABLED until then.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Database (for development)
DATABASE_URL="file:./dev.db"

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# SMS Gateway (OTP)
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api.sms-provider.com

# Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=job-portal-uploads

# Redis Cache
REDIS_URL=redis://localhost:6379

# Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Monitoring
SENTRY_DSN=your-sentry-dsn

# Feature Flags
NEXT_PUBLIC_ENABLE_VOICE_SEARCH=true
NEXT_PUBLIC_ENABLE_SKILL_VERIFICATION=true
